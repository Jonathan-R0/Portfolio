  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint app components lib tailwind.config.ts next.config.js",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/i18n.test.mjs tests/routing.test.mjs tests/theme.test.mjs tests/carousel.test.mjs",
    "test:export": "node --test tests/seo.test.mjs",
    "format": "prettier --write \"{app,components,lib}/**/*.{ts,tsx}\" \"tests/**/*.mjs\"",
    "format:check": "prettier --check \"{app,components,lib}/**/*.{ts,tsx}\" \"tests/**/*.mjs\"",
    "check": "npm run lint && npm run typecheck && npm run format:check && npm test"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.1.0",
    "class-variance-authority": "^0.7.1",
