    "lucide-react": "^0.468.0",
    "next": "^16.4.3",
    "portfolio": "file:",
    "react": "^18",
    "react-dom": "^18",
    "recharts": "^2.14.1",
    "tailwind-merge": "^2.5.5",
    "tailwindcss-animate": "^1.0.7"
  },
  "overrides": {
    "postcss": "^8.5.10",
    "postcss-selector-parser": "^7.1.7"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "14.2.16",
    "postcss": "^8.5.10",
